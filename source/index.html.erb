---
title: Out of my mind...
per_page: 7
pageable: false
---
<%
@home = true
@active = nil
first_year = blog.articles.map(&:date).min.year
@dateline = [
  'Frederic Jean',
  'Intermodal scheduling at BNSF &middot; ex-AWS'.html_safe,
  "Vol. #{volume_numeral}",
  "#{blog.articles.size} articles since #{first_year}"
]
articles = blog.articles.first(7)
lead, rest = articles.first, articles.drop(1)
%>
<div class="with-rail with-rail--home">
  <div>
    <article class="lead">
      <p class="kicker">Lead &middot; <%= lead.date.strftime('%B %-d, %Y') %></p>
      <h1><a class="pl" href="<%= lead.url %>"><%= lead.title %></a></h1>
      <% if lead.data['summary'] %>
        <p class="standfirst"><%= lead.data['summary'] %></p>
        <hr class="rule-cut" style="margin: 22px 0 26px;">
      <% end %>
      <div class="lead-body prose"><%= excerpt_for(lead, characters: 700) %></div>
      <p class="continue-link"><a href="<%= lead.url %>">Continue reading &rarr;</a></p>
    </article>

    <hr class="rule-cut" style="margin: 0 0 28px;">

    <div class="extracts">
      <% rest.each do |article| %>
        <article>
          <h2><a class="pl" href="<%= article.url %>"><%= article.title %></a></h2>
          <p class="date"><%= article.date.strftime('%b %-d, %Y') %></p>
          <%= excerpt_for(article, characters: 190) %>
        </article>
      <% end %>
    </div>

    <p class="continue-link" style="margin-top: 36px;"><a href="/archive/">All <%= blog.articles.size %> articles, <%= first_year %> to today &rarr;</a></p>
  </div>

  <%= partial 'partials/rail' %>
</div>
