<!doctype html>
<html>
<head>
<title><%= title %></title>
<meta charset="utf-8" />
<meta http-equiv='X-UA-Compatible' content='IE=edge;chrome=1' />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%= stylesheet_link_tag 'all' %>
<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed.xml">
</head>
<body>
  <div class="shell">
    <%= partial 'partials/masthead', locals: { home: @home, active: @active, dateline: @dateline } %>
    <%= yield %>
    <%= partial 'partials/colophon', locals: { full: @home } %>
  </div>
  <script id="dsq-count-scr" src="//fredjean-net.disqus.com/count.js" async></script>
  <script type="text/javascript" src="/javascripts/all.js"></script>
</body>
</html>
