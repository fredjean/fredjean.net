<%
size ||= 84
link ||= nil
link_label ||= 'More &rarr;'.html_safe
%>
<div>
  <p class="rail-label">The column</p>
  <div class="column-block">
    <div class="halftone portrait" style="width: <%= size %>px; height: <%= size %>px;">
      <%= image_tag 'avatar.png', alt: 'Frederic Jean' %>
    </div>
    <p>
      <%= blurb %>
      <% if link %> <a href="<%= link %>"><%= link_label %></a><% end %>
    </p>
  </div>
</div>
